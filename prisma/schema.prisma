generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Game {
  id          String       @id @default(cuid())
  title       String
  developer   String?
  genre       String?
  thumbnail   String?
  robloxUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  screenshots Screenshot[]
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  sortOrder   Int          @default(0)
  screenshots Screenshot[]
}

model TagGroup {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)
  tags      Tag[]
}

model Tag {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  sortOrder  Int             @default(0)
  tagGroupId String
  tagGroup   TagGroup        @relation(fields: [tagGroupId], references: [id])
  screenshots ScreenshotTag[]

  @@index([tagGroupId])
}

model Screenshot {
  id         String          @id @default(cuid())
  imageUrl   String
  caption    String?
  gameId     String
  categoryId String
  createdAt  DateTime        @default(now())
  game       Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id])
  tags       ScreenshotTag[]

  @@index([gameId])
  @@index([categoryId])
}

model ScreenshotTag {
  screenshotId String
  tagId        String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id])

  @@id([screenshotId, tagId])
  @@index([tagId])
}
